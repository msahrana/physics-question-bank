model Chapter {
  id          String  @id @default(uuid())
  title       String
  slug        String
  chapterNo   Int
  description String?
  thumbnail   String?
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)
  courseId    String

  course         Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  topics         Topic[]
  stimuli        Stimulus[]
  mcqQuestions   MCQQuestion[]
  cqQuestions    CQQuestion[]
  shortQuestions ShortQuestion[]

  createdById    String?
  createdBy User? @relation( "ChapterCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@unique([courseId, chapterNo])
  @@index([courseId, isPublished, sortOrder])
  @@index([createdById])

  @@map("chapters")
}
