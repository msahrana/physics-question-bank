model Stimulus {
  id           String @id @default(uuid())
  title        String?
  content      Json
  contentText  String?

  chapterId    String
  chapter      Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  mcqQuestions MCQQuestion[]
  cqQuestions  CQQuestion[]

  createdById  String?
  createdBy    User?   @relation("StimulusCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([createdById])

   @@map("stimulus")
} 
